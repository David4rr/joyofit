{
  "expo": {
    "name": "JoyoFit",
    "slug": "joyofit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "joyofit",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.joyodigitama.joyofit",
      "buildNumber": "1",
      "appleTeamId": "F6Q6UFUK69",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "JoyoFit uses Bluetooth to connect to your Huawei or Honor watch and sync its data.",
        "NSBluetoothPeripheralUsageDescription": "JoyoFit uses Bluetooth to connect to your Huawei or Honor watch and sync its data.",
        "NSLocationWhenInUseUsageDescription": "JoyoFit uses your approximate location only to look up the weather for your area and send it to your watch. Only coordinates rounded to about 1 km go to the weather service (Open-Meteo); your watch also receives that approximate position.",
        "NSHealthShareUsageDescription": "JoyoFit does not read your Apple Health data. It only writes the data recorded by your watch.",
        "NSHealthUpdateUsageDescription": "Allow JoyoFit to save the steps, distance, calories, heart rate, blood oxygen, sleep, workouts and workout routes recorded by your watch to Apple Health.",
        "UIBackgroundModes": ["bluetooth-central"]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.joyodigitama.joyofit",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-release-signing",
      "./plugins/with-version-code",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F9F6F1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0D1112"
          }
        }
      ]
    ],
    "extra": {
      "joyorogoUrl": "https://api.joyorogo.com",
      "cloudUrl": "https://api.fit.joyorogo.com"
    }
  }
}
