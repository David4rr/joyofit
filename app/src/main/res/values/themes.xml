<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Compose owns the actual Material3 theme; this is the
         launch/splash theme used before Compose content attaches. -->
    <style name="Theme.WatchFitRE" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
