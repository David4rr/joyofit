<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Privacy: keep all captured data on-device only. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="watchfit-logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="watchfit-logs/" />
    </device-transfer>
</data-extraction-rules>
