<!-- Debug builds only: the adb-driven developer LE probe is not part of release or Play builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Developer LE probe driven from adb (BleProbeReceiver). DUMP is held by the adb shell and the system only, so no app can send it. -->
    <receiver
      android:name="com.joyodigitama.huaweiwear.BleProbeReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP">
      <intent-filter>
        <action android:name="com.joyodigitama.joyofit.BLE_PROBE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
