<div class="root" onswipe="onSwipe">
  <text class="title">JoyoFit Fuel</text>
  <text class="subtitle">Fat and carbs from heart rate</text>
  <div class="card">
    <text class="profile-line">{{profileLine}}</text>
    <text class="profile-src">Profile {{profileSource}}</text>
  </div>
  <div class="btn btn-start" onclick="start">
    <text class="btn-text btn-text-start">Start</text>
  </div>
  <div class="row">
    <div class="btn btn-small" style="width: {{profileBtnW}}px;" onclick="openProfile">
      <text class="btn-text btn-text-small" style="width: {{profileBtnW}}px;">Profile</text>
    </div>
    <div class="btn btn-small btn-resume" if="{{hasResume}}" onclick="resume">
      <text class="btn-text btn-text-small">Resume</text>
    </div>
  </div>
  <text class="link-text" style="color: {{linkColor}};">{{linkText}}</text>
</div>
