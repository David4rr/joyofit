<div class="root">
  <div class="screen" if="{{editing === ''}}">
    <text class="title">Profile</text>
    <div class="line" onclick="editWeight">
      <text class="key">Weight</text>
      <text class="val">{{weightText}}</text>
    </div>
    <div class="line" onclick="editAge">
      <text class="key">Age</text>
      <text class="val">{{ageText}}</text>
    </div>
    <div class="line" onclick="editBorn">
      <text class="key">Birth year</text>
      <text class="val">{{bornText}}</text>
    </div>
    <div class="line" onclick="editSex">
      <text class="key">Sex</text>
      <text class="val">{{sexText}}</text>
    </div>
    <div class="line" onclick="editMaxHr">
      <text class="key">Max heart rate</text>
      <text class="val">{{maxHrText}}</text>
    </div>
    <div class="back" onclick="back">
      <text class="back-text">Back</text>
    </div>
  </div>

  <div class="screen" if="{{editing !== ''}}">
    <text class="title">{{editTitle}}</text>
    <picker-view class="picker" if="{{editing === 'weight'}}" range="{{weightRange}}" selected="{{pickSelected}}" onchange="onPick"></picker-view>
    <picker-view class="picker" if="{{editing === 'age'}}" range="{{ageRange}}" selected="{{pickSelected}}" onchange="onPick"></picker-view>
    <picker-view class="picker" if="{{editing === 'born'}}" range="{{bornRange}}" selected="{{pickSelected}}" onchange="onPick"></picker-view>
    <picker-view class="picker" if="{{editing === 'sex'}}" range="{{sexRange}}" selected="{{pickSelected}}" onchange="onPick"></picker-view>
    <picker-view class="picker" if="{{editing === 'maxHr'}}" range="{{maxHrRange}}" selected="{{pickSelected}}" onchange="onPick"></picker-view>
    <div class="buttons">
      <div class="btn btn-cancel" onclick="cancel">
        <text class="btn-text">Cancel</text>
      </div>
      <div class="btn btn-save" onclick="save">
        <text class="btn-text btn-text-save">Save</text>
      </div>
    </div>
  </div>
</div>
